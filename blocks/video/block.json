{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "fastpix/video",
  "version": "2.0.0",
  "title": "FastPix Video",
  "category": "media",
  "icon": "video-alt3",
  "description": "Pick a video from your FastPix library, or upload one now. Your site defaults are already applied.",
  "keywords": ["video", "fastpix", "player", "stream"],
  "textdomain": "fastpix",
  "attributes": {
    "videoId":         { "type": "string",  "default": "" },
    "autoplay":        { "type": "boolean", "default": false },
    "muted":           { "type": "boolean", "default": false },
    "loop":            { "type": "boolean", "default": false },
    "controls":        { "type": "boolean", "default": true },
    "poster":          { "type": "string",  "default": "" },
    "thumbnailTime":   { "type": "number",  "default": 1 },
    "startTime":       { "type": "number",  "default": 0 },
    "aspectRatio":     { "type": "string",  "default": "" },
    "accentColour":    { "type": "string",  "default": "#6D22CD" },
    "showChapters":    { "type": "boolean", "default": true },
    "showTranscript":  { "type": "boolean", "default": false },
    "captionsDefault": { "type": "boolean", "default": false },
    "lazyLoad":        { "type": "boolean", "default": true },
    "clickToPlay":     { "type": "boolean", "default": true },
    "keyboard":        { "type": "boolean", "default": true },
    "resume":          { "type": "boolean", "default": true },
    "completeAt":      { "type": "number",  "default": 90 },
    "trackViewer":     { "type": "boolean", "default": false },
    "fallbackTitle":   { "type": "string",  "default": "" },
    "fallbackPoster":  { "type": "string",  "default": "" },
    "fallbackPolicy":  { "type": "string",  "default": "public" },
    "fallbackLink":    { "type": "string",  "default": "" }
  },
  "supports": { "align": ["wide", "full"], "html": false, "anchor": true },
  "editorScript": "file:./editor.js",
  "style": "fastpix-embed"
}
